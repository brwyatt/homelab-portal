ui:
  title: "Homelab Portal"
  subtitle: "Services & Resources"
  theme: "fiber-optic"
  show_search: true
  show_network_badge: true
  show_user_badge: true
  footer_text: "Homelab Portal"

auth:
  enabled: false
  header_user: "Remote-User"
  header_name: "Remote-Name"
  header_email: "Remote-Email"
  header_groups: "Remote-Groups"
  header_group_delimiter: ","
  login_url: null
  logout_url: null

network:
  trusted_proxies:
    - "127.0.0.1/32"
    - "::1/128"
  fallback_class: "external"
  fallback_name: "External"
  fallback_icon: "globe"

network_classes:
  management:
    name: "Management Network"
    icon: "shield"
  internal:
    name: "Home Network"
    icon: "home"
  guest:
    name: "Guest Network"
    icon: "users"
  external:
    name: "External"
    icon: "globe"

subnets:
  - cidr: "192.168.1.0/24"
    name: "Internal LAN"
    network_class: "internal"
  - cidr: "10.10.0.0/24"
    name: "Admin Subnet"
    network_class: "management"

# Categories and their nested services.
# When order is omitted, sections and services preserve their natural YAML definition order.
categories:
  - id: "core"
    name: "Core Services"
    icon: "server"
    services:
      - name: "Proxmox VE"
        url: "https://pve.example.com:8006"
        description: "Virtualization management cluster"
        icon: "server"
        network_classes:
          - "management"
      - name: "FreeIPA"
        url: "https://ipa.example.com"
        description: "Identity management & directory services"
        icon: "key"
        network_classes:
          - "management"

  - id: "media"
    name: "Media & Streaming"
    icon: "film"
    services:
      - name: "Jellyfin"
        url: "https://jellyfin.example.com"
        description: "Open source media streaming system"
        icon: "film"

  - id: "home_automation"
    name: "Home Automation"
    icon: "home"
    services:
      - name: "Home Assistant"
        url: "https://homeassistant.example.com"
        description: "Home automation and IoT dashboard"
        icon: "home"
